{
  // Static-assets-only Worker: no `main` entry point, so there is no Worker
  // script — Cloudflare just serves the exported files. Asset requests are
  // unmetered.
  //
  // `dist/` is the unpacked `mint export` output and is NOT in git; build it
  // with `just export` locally, or with this build command in Workers Builds:
  //
  //   npx --yes mint@latest export && rm -rf dist && mkdir -p dist \
  //     && (unzip -q -o export.zip -d dist || python3 -m zipfile -e export.zip dist) \
  //     && cp .assetsignore dist/.assetsignore
  //
  // The Mintlify export carries no 404.html, so not_found_handling is left at
  // its default rather than pointing at a page that does not exist.
  "name": "docs-mantis",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  }
}
